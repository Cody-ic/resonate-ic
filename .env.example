# Website accounts. Generate a random secret; never commit it.
BETTER_AUTH_SECRET=
# Required in production; use the actual HTTPS site origin.
BETTER_AUTH_URL=
# Enable only behind a trusted platform proxy that strips forged identity headers.
PLATFORM_AUTH_ENABLED=false
# Optional verified SEU public IPv4/IPv6 CIDRs, comma separated. Empty: no campus
# exemption. Removes only the login IP aggregate cap; per-account limit remains.
# Never enter campus-private 10.x addresses or the entire CERNET allocation.
SEU_LOGIN_TRUSTED_CIDRS=
# Comma-separated stable profile IDs from /api/me, never nicknames or emails.
ADMIN_USER_IDS=
# Separate DeepSeek credentials, models and monthly budgets. Server only.
PROJECT_REVIEW_API_KEY=
PROJECT_REVIEW_MODEL=deepseek-flash
# false holds public release; AI and human review continue normally.
PROJECT_PUBLICATION_ENABLED=false
DISCUSSION_REVIEW_API_KEY=
DISCUSSION_REVIEW_MODEL=deepseek-flash
REVIEW_DISCUSSION_CONCURRENCY=2
REVIEW_PROJECT_CONCURRENCY=1
# Either zero keeps that channel queued without a paid request.
PROJECT_AI_MONTHLY_MAX_CALLS=0
PROJECT_AI_MONTHLY_BUDGET_MICROS=0
DISCUSSION_AI_MONTHLY_MAX_CALLS=0
DISCUSSION_AI_MONTHLY_BUDGET_MICROS=0
# Monthly grants roll over, oldest first. Shared grant limits both keys together.
# All budget values are MICRO CNY (1 yuan = 1000000).
AI_TOTAL_MONTHLY_BUDGET_MICROS=0
# CNY per million tokens. Verify official prices before enabling calls.
# Reserve at peak pricing even when projects run off-peak; not an actual bill.
AI_INPUT_CNY_PER_MTOK=2
AI_OUTPUT_CNY_PER_MTOK=8
AI_CACHED_INPUT_CNY_PER_MTOK=0.04
# Optional extra off-peak holidays in Beijing timezone, YYYY-MM-DD comma separated.
AI_OFFPEAK_DATES=
# Administrator alerts. Ordinary users receive site notifications.
ADMIN_EMAILS=
# Outlook / Microsoft Graph delegated OAuth. Configure only after authorization.
MAIL_PROVIDER=
MAIL_FROM=
MAIL_GRAPH_CLIENT_ID=
MAIL_GRAPH_CLIENT_SECRET=
MAIL_GRAPH_REFRESH_TOKEN=
# off: never send. test: exact recipients only. live: normal queued delivery.
MAIL_DELIVERY_MODE=off
MAIL_TEST_RECIPIENTS=
# Independent opt-in, after delivery is verified. Existing accounts can verify
# from /verify-email; merely configuring credentials does not change login.
MAIL_REQUIRE_EMAIL_VERIFICATION=false
