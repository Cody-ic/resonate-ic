# Copy to a PRIVATE environment file. Never commit the filled file.
# These are application settings, not a complete hosting-provider deployment.
BETTER_AUTH_URL=https://YOUR-DOMAIN
BETTER_AUTH_SECRET=
PLATFORM_AUTH_ENABLED=false
# Get the stable profile ID from /api/me after creating and verifying your account.
# Never use local_seedy or a nickname as the production administrator.
ADMIN_USER_IDS=
ADMIN_EMAILS=
MAIL_PROVIDER=graph
MAIL_FROM=
MAIL_GRAPH_CLIENT_ID=
MAIL_GRAPH_REFRESH_TOKEN=
MAIL_DELIVERY_MODE=live
MAIL_REQUIRE_EMAIL_VERIFICATION=true
PROJECT_REVIEW_API_KEY=
DISCUSSION_REVIEW_API_KEY=
PROJECT_REVIEW_MODEL=deepseek-flash
DISCUSSION_REVIEW_MODEL=deepseek-flash
REVIEW_DISCUSSION_CONCURRENCY=2
REVIEW_PROJECT_CONCURRENCY=1
PROJECT_AI_MONTHLY_MAX_CALLS=5000
DISCUSSION_AI_MONTHLY_MAX_CALLS=5000
PROJECT_AI_MONTHLY_BUDGET_MICROS=30000000
DISCUSSION_AI_MONTHLY_BUDGET_MICROS=30000000
AI_TOTAL_MONTHLY_BUDGET_MICROS=50000000
# Verify provider prices before enabling; carried-over balances remain in DB.
AI_INPUT_CNY_PER_MTOK=2
AI_OUTPUT_CNY_PER_MTOK=8
AI_CACHED_INPUT_CNY_PER_MTOK=0.04
# Enable only after data migration and production acceptance are complete.
PROJECT_PUBLICATION_ENABLED=false
SEU_LOGIN_TRUSTED_CIDRS=
